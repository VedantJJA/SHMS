# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Cassandra
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=shms

# Server
PORT=5000

# Persistent databases are required by default. Preview mode never proves persistence.
ALLOW_IN_MEMORY_FALLBACK=false
